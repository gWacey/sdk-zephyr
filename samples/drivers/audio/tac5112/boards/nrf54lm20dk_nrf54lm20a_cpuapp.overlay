 *
 * Wires a physical TAC5112 to the nRF54LM20 DK for this sample: control
 * over the &i2c22 TWIM instance, with optional reset and fault GPIOs.
 */

#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&pinctrl {
	i2c22_tac5112_default: i2c22_tac5112_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 7)>,
				<NRF_PSEL(TWIM_SDA, 1, 6)>;
			bias-pull-up;
		};
	};

	i2c22_tac5112_sleep: i2c22_tac5112_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 7)>,
				<NRF_PSEL(TWIM_SDA, 1, 6)>;
			low-power-enable;
		};
	};
};

&i2c22 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c22_tac5112_default>;
	pinctrl-1 = <&i2c22_tac5112_sleep>;
	pinctrl-names = "default", "sleep";

	tac5112: audio-codec@50 {
		compatible = "ti,tac5112";
		reg = <0x50>;
		fault-gpios = <&gpio3 2 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	tdm_tac5112_default: tdm_tac5112_default {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 3)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 0)>,
				<NRF_PSEL(TDM_SDOUT, 1, 13)>,
				/* codec DOUT (ADC data) -> nRF SDIN: EXP C4 -> P1.05 */
				<NRF_PSEL(TDM_SDIN, 1, 5)>;
		};
	};

	tdm_tac5112_sleep: tdm_tac5112_sleep {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 3)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 0)>,
				<NRF_PSEL(TDM_SDOUT, 1, 13)>,
				/* codec DOUT (ADC data) -> nRF SDIN: EXP C4 -> P1.05 */
				<NRF_PSEL(TDM_SDIN, 1, 5)>;
			low-power-enable;
		};
	};
};

&tdm {
	status = "okay";
	pinctrl-0 = <&tdm_tac5112_default>;
	pinctrl-1 = <&tdm_tac5112_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	aliases {
		tac5112-i2s = &tdm;
	};
};
