#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	tac5112: audio-codec@50 {
		compatible = "ti,tac5112";
		reg = <0x50>; /* ADDR strapped to GND */

		/* Optional codec IRQ line. Uncomment and set to the GPIO you
		 * wired the codec's GPIO1 (interrupt output) to, active low:
		 *   fault-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
		 */
	};
};

&pinctrl {
	i2s0_tac5112_default: i2s0_tac5112_default {
		group1 {
			/* TODO: set to your wiring. Placeholders on port 1. */
			psels = <NRF_PSEL(I2S_SCK_M, 1, 10)>,  /* BCLK  -> codec BCLK  */
				<NRF_PSEL(I2S_LRCK_M, 1, 11)>, /* LRCLK -> codec FSYNC */
				<NRF_PSEL(I2S_SDOUT, 1, 12)>,  /* SDOUT -> codec DIN   */
				<NRF_PSEL(I2S_SDIN, 1, 13)>;   /* SDIN  <- codec DOUT  */
		};
	};

	i2s0_tac5112_sleep: i2s0_tac5112_sleep {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 1, 10)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 11)>,
				<NRF_PSEL(I2S_SDOUT, 1, 12)>,
				<NRF_PSEL(I2S_SDIN, 1, 13)>;
			low-power-enable;
		};
	};
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_tac5112_default>;
	pinctrl-1 = <&i2s0_tac5112_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	aliases {
		tac5112-i2s = &i2s0;
	};
};
